# Required only for real Zen calls.
OPENCODE_ZEN_API_KEY=

# Official Responses API endpoint and active profile defaults.
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=muse-spark-1.3
OPENCODE_ZEN_EFFORT=xhigh

# Pipeline defaults.
PROBLEM_FACTORY_BATCH_SIZE=5
PROBLEM_FACTORY_MAX_RETRIES=4
PROBLEM_FACTORY_REQUEST_TIMEOUT_SECONDS=180
PROBLEM_FACTORY_BACKOFF_BASE_SECONDS=2
PROBLEM_FACTORY_BACKOFF_MAX_SECONDS=60

# Optional Judge0 compatibility smoke test only. Language IDs belong here,
# never in problem packages, because they vary by Judge0 installation.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
JUDGE0_CPP20_LANGUAGE_ID=
